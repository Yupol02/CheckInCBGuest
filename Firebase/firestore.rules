// ============================================================================
// CheckingCBGuest — Firestore Güvenlik Kuralları
// ============================================================================
//
// Sürüm: v1.7 (NİHAİ) — 2026-09-02
//
// Geçiş sürümü v1.6.1'de okuma kısıtı GEÇİCİ olarak kapalıydı. 1.7 ile hem iOS
// hem Android tüm cihazlarda güncellendiği için kısıtlar tam olarak açıldı;
// dosyada geçici hiçbir şey kalmadı.
//
// ---------------------------------------------------------------------------
// NE UYGULANIYOR
// ---------------------------------------------------------------------------
//   1. Geçmiş etkinlikler ve onların misafirleri yalnızca YÖNETİCİYE görünür.
//      Ölçüt `events/<id>.eventDayKey` — 20260902 gibi sıralanabilir tam sayı.
//   2. Etkinlik GÜNCELLEME yalnızca yöneticide. Etkinlik OLUŞTURMA herkese açık,
//      ancak `eventDayKey` alanını yazmak ZORUNLU.
//   3. Etkinlik ve misafir SİLME yalnızca yöneticide.
//   4. Bir e-posta bir cihaza bağlanır; muafiyet yalnızca Console'dan açılır.
//
// ---------------------------------------------------------------------------
// NEDEN AYRI BİR `eventDayKey` ALANI VAR
// ---------------------------------------------------------------------------
// `date` alanı "2 Eylül 2026" biçiminde serbest TÜRKÇE metindir; kural dili ne
// Türkçe ay adı ayrıştırır ne de metni tarihe çevirir. Bu yüzden aynı gün ayrıca
// YYYYAAGG tam sayısı olarak yazılır ve hem istemci sorgusu hem bu kurallar o
// alanı okur. Alanı iOS ve Android'in DÖRT yazma yolu da yazar: oluşturma,
// güncelleme, senkronizasyon ve soft-delete.
//
// ---------------------------------------------------------------------------
// İSTEMCİ SORGUSU BU KURALA UYMAK ZORUNDA
// ---------------------------------------------------------------------------
// Firestore kuralları FİLTRE DEĞİLDİR: bir liste sorgusu ya tamamen geçer ya
// tamamen reddedilir. Yönetici olmayan istemci `events` sorgusuna şunu eklemek
// ZORUNDADIR:
//
//     eventDayKey >= <bugünün anahtarı>
//
// Daraltılmamış sorgu belge elemek yerine `permission-denied` alır. iOS'ta bu
// daraltma tek kapıdan geçer: FirebaseEventRepository.scopedEventsQuery.
// Android'de karşılığı FirebaseEventRepository.eventsSnapshotFlow'dur.
//
// ---------------------------------------------------------------------------
// GEÇMİŞTE YAŞANAN İKİ ARIZA — TEKRARLAMAYIN
// ---------------------------------------------------------------------------
//   1. Kural, `eventDayKey` mevcut dokümanlara geri doldurulmadan yayınlandı.
//      Aralık sorgusu o alanı taşımayan belgeyi hiç döndürmez; alan hiçbir
//      belgede olmayınca yönetici olmayan herkes BOMBOŞ liste gördü.
//      → Kuralı yayınlamadan önce alanın TÜM dokümanlarda dolu olduğunu
//        doğrulayın: node Firebase/scripts/backfill-event-day-key.js  (eksik: 0)
//
//   2. Kural, istemciler güncellenmeden yayınlandı. Sorguyu daraltmayan eski
//      sürümler tüm listeyi reddedilmiş aldı.
//      → Kuralı ancak iOS ve Android'in yeni sürümleri TÜM cihazlara
//        ulaştıktan SONRA yayınlayın.
//
// ---------------------------------------------------------------------------
// BU DOSYA TEK SÜRÜMLÜ KOPYADIR
// ---------------------------------------------------------------------------
// GuestsBackend/firebase.json içinde `firestore.rules` tanımlı DEĞİLDİR
// (yalnızca indexes ve functions var), dolayısıyla
// `firebase deploy --only firestore:rules` oradan çalışmaz. Diskte başka bir
// firestore.rules dosyası da yoktur — sürüm kontrolündeki tek kopya budur.
//
// YAYINLAMA: İçeriği Firebase Console → Firestore Database → Rules sekmesine
// yapıştırıp Publish edin. Değişiklikten sonra bu dosyayı da güncel tutun ki
// depo ile canlı kurallar ayrışmasın.
//
// DİKKAT: her yönetici e-postası için admin_users/<küçük-harfli-eposta>
// dokümanı { isAdmin: true } ile mevcut OLMALIDIR. Yoksa yönetici cihazlar
// authorized_devices'a yazamaz ve yönetici işlevleri kilitlenir.
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================================
    // YARDIMCI FONKSİYONLAR
    // ==========================================================================

    function signedIn() {
      return request.auth != null;
    }

    // Oturum açmış kullanıcının normalize edilmiş e-postası.
    // NOT: rules'taki lower() locale'den BAĞIMSIZDIR. iOS istemcisi
    // AppAuth.normalizedEmailKey() içinde en_US_POSIX ile küçültür; Türkçe
    // locale'de "I" → "ı" olacağı için bu zorunludur, aksi halde doküman ID'si
    // buradaki lower() ile eşleşmez ve her yazma reddedilirdi.
    function normEmail() {
      return request.auth.token.get('email', '').lower();
    }

    // Yönetici listesi `admin_users` koleksiyonundadır.
    // Yönetici eklemek : admin_users/<eposta> dokümanı, alan isAdmin = true
    // Yönetici çıkarmak: dokümanı sil veya isAdmin = false yap
    function isAdmin() {
      return signedIn()
          && exists(/databases/$(database)/documents/admin_users/$(normEmail()))
          && get(/databases/$(database)/documents/admin_users/$(normEmail()))
               .data.get('isAdmin', false) == true;
    }

    // ---- Geçmiş etkinlik görünürlüğü -----------------------------------------

    // Bir zaman damgasından sıralanabilir gün anahtarı: 2026-08-31 -> 20260831.
    function dayKeyOf(t) {
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    // Yönetici olmayan cihazın görebileceği EN ESKİ gün.
    //
    // request.time UTC'dir; Türkiye sabit UTC+3 (yaz saati yok) olduğu için 3 saat
    // eklenerek yerel güne çevrilir.
    //
    // Neden 1 gün tolerans (-24s)? İstemci, sorgunun alt sınırını KENDİ saatinden
    // hesaplamak zorundadır. Cihaz saati veya zaman dilimi sunucudan geride kalırsa
    // alt sınır bir gün eskiye kayar; tolerans olmadan sorgu tek tek belge elemek
    // yerine TAMAMEN reddedilir ve kullanıcı bomboş bir liste görür. Bedeli
    // bilinçlidir: kötü niyetli bir istemci sorgusunu elle bir gün geriye çekerek
    // yalnızca DÜNKÜ etkinlikleri görebilir, daha eskisini göremez.
    function minVisibleDayKey() {
      return dayKeyOf(request.time + duration.value(3, 'h') - duration.value(24, 'h'));
    }

    // Misafir kayıtları için üst etkinliğin görünürlüğü.
    //
    // isAdmin() BİLEREK önce çağrılır: üst etkinlik dokümanı (yarım kalmış bir silme
    // yüzünden) yoksa get() hata verir ve kural reddeder; yönetici bu durumda da
    // öksüz kayıtlara erişebilmelidir.
    //
    // Koşul yalnızca ÜST belgeye bakar, `resource.data`ya dokunmaz. Bu bilinçlidir:
    // üst belgeye bağlı bir koşul tüm alt koleksiyon sorgusu için tekdüze doğru ya
    // da yanlıştır, dolayısıyla misafir sorgularının değişmesi gerekmez.
    function parentEventVisible(eventId) {
      return isAdmin()
          || get(/databases/$(database)/documents/events/$(eventId))
               .data.get('eventDayKey', 0) >= minVisibleDayKey();
    }

    // Bu yazma, kaydı "silinmiş" duruma geçiriyor mu?
    // Zaten silinmiş bir kaydın tekrar yazılması silme sayılmaz.
    function marksDeleted() {
      return request.resource.data.get('deleted', false) == true
          && resource.data.get('deleted', false) != true;
    }

    // ==========================================================================
    // ADMIN USERS - Yönetici E-posta Listesi
    // ==========================================================================
    // Doküman ID'si = küçük harfli e-posta, alan: isAdmin (boolean).
    // İstemci ASLA yazamaz — yalnızca Console / Admin SDK.
    //
    // Okuma yalnızca kişinin KENDİ kaydıyla sınırlıdır (kimse başkasının yönetici
    // olup olmadığını göremez). isAdmin() içindeki get()/exists() çağrıları
    // kuralları atladığı için bu kısıt isAdmin()'i etkilemez.
    match /admin_users/{emailId} {
      allow read: if signedIn() && emailId == normEmail();
      allow write: if false;
    }

    // ==========================================================================
    // DEVICE BINDINGS - E-posta ↔ Cihaz Bağı
    // ==========================================================================
    // Bir e-posta = bir cihaz. Doküman ID'si küçük harfli e-postadır, böylece
    // sahip Console'da dokümanı e-posta ile bulup silerek bağı sıfırlayabilir.
    match /device_bindings/{emailId} {

      allow read: if signedIn() && emailId == normEmail();

      // İlk bağlama.
      allow create: if signedIn()
        && emailId == normEmail()
        && request.resource.data.email == emailId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() > 0
        // Muafiyet bayrağını istemci AÇAMAZ — yalnızca Console.
        && request.resource.data.get('allowMultipleDevices', false) == false;

      // deviceId DEĞİŞTİRİLEMEZ — özelliğin bel kemiği budur.
      // Pratikte yalnızca lastSeenAt güncellenebilir.
      allow update: if signedIn()
        && emailId == normEmail()
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.boundAt == resource.data.boundAt
        // Muafiyet bayrağı istemci tarafından DEĞİŞTİRİLEMEZ.
        && request.resource.data.get('allowMultipleDevices', false)
           == resource.data.get('allowMultipleDevices', false);

      // MUAFİYET (allowMultipleDevices: true)
      // Bu alanı true yapılan hesap cihaz kısıtından muaf olur; birden fazla
      // cihazdan giriş yapabilir. Kullanım amacı App Store inceleme demo
      // hesabıdır (incelemeci hem iPhone hem iPad'de test edebilsin).
      // Yalnızca Console'dan açılıp kapatılır; onay sonrası KAPATIN.

      // Bağı YALNIZCA sahip (Console) sıfırlayabilir.
      allow delete: if false;
    }

    // ==========================================================================
    // AUTHORIZED DEVICES - Cihaz Yetkilendirme
    // ==========================================================================
    // Herkes cihaz kaydını okuyabilir ve kendi kaydını yazabilir; ancak
    // isAdmin=true yalnızca admin_users'da kayıtlı bir hesapla açılabilir.
    match /authorized_devices/{deviceId} {
      allow read: if signedIn();
      allow write: if signedIn()
                   && (request.resource.data.get('isAdmin', false) != true || isAdmin());
    }

    // ==========================================================================
    // EVENTS - Etkinlik Yönetimi
    // ==========================================================================
    // OKUMA: yönetici olmayan cihaz yalnızca bugünü ve gelecekteki etkinlikleri
    // görür. `get` ile `list` AYRI yazılır ve bu ZORUNLUDUR:
    //
    //   * list (sorgu) tarafında koşul, sorgunun kendi filtresinden
    //     KANITLANABİLİR olmak zorundadır. Varsayılanlı biçim
    //     (`resource.data.get('eventDayKey', 0)`) kanıtlanamaz; Firestore bunu
    //     değerlendirme hatası sayar ve DARALTILMIŞ sorguyu bile reddeder.
    //     Bu yüzden alan DOĞRUDAN okunur. Sonucu: `eventDayKey` alanı OLMAYAN
    //     belge, yönetici olmayanın listesinde HİÇ görünmez.
    //
    //   * get (tek belge) tarafında böyle bir kısıt yoktur; orada eksik alanı
    //     görünür sayan hoşgörülü biçim kullanılır ki tek bir eksik kayıt detay
    //     ekranlarını kırmasın.
    //
    // Tek parça `allow read` YAZMAYIN — liste sorguları reddedilir.
    //
    // OLUŞTURMA herkese açıktır ama `eventDayKey` zorunludur: alanı yazmayan bir
    // etkinlik yönetici olmayan hiçbir cihazda görünmez, o yüzden sessiz kayıp
    // yerine gürültülü ret tercih edilmiştir.
    //
    // GÜNCELLEME yalnızca yöneticidedir (1.7 ile gelen etkinlik düzenleme özelliği
    // yöneticiye özeldir; arayüzde gizlemek zorlama değildir).
    match /events/{eventId} {
      allow get:  if signedIn()
                  && (isAdmin()
                      || resource.data.get('eventDayKey', 99999999) >= minVisibleDayKey());
      allow list: if signedIn()
                  && (isAdmin() || resource.data.eventDayKey >= minVisibleDayKey());
      allow create: if signedIn() && request.resource.data.eventDayKey is int;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // GUESTS - Genel Misafir Listesi (Public)
    // ==========================================================================
    // Giriş/çıkış, saat düzeltme, ünvan güncelleme vb. herkese açık.
    // SİLME yalnızca yöneticiye.
    //
    // Geçmiş etkinliğin misafir listesi yalnızca yöneticiye açıktır. Asıl korunan
    // veri budur: ad, ünvan, plaka, giriş/çıkış saatleri, notlar.
    //
    // YAZMA bilinçli olarak kısıtlanmaz: geçmiş etkinlikte değişikliği zaten
    // istemci engelliyor; buraya koşul eklemek, gün anahtarı eksik kalmış tek bir
    // kayıtta tüm giriş/çıkış işlemlerini kilitleme riskini getirirdi.
    match /events/{eventId}/guests/{guestId} {
      allow read: if signedIn() && parentEventVisible(eventId);
      allow create: if signedIn();
      allow update: if signedIn() && (!marksDeleted() || isAdmin());
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // GUESTS_SECURE - Kırmızı Liste Misafirleri
    // ==========================================================================
    // Onay bekleyen kayıtlar. /guests ile AYNI model uygulanır: oluşturma ve
    // normal güncelleme herkese açık (misafir ekleyen görevlinin kırmızı listeye
    // takılan kaydı buraya düşer), okuma üst etkinliğe bağlı, silme yöneticiye.
    match /events/{eventId}/guests_secure/{guestId} {
      allow read: if signedIn() && parentEventVisible(eventId);
      allow create: if signedIn();
      allow update: if signedIn() && (!marksDeleted() || isAdmin());
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // RED LIST - Kırmızı Liste Koleksiyonu (eski)
    // ==========================================================================
    match /red_list/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ==========================================================================
    // ADMIN RED LIST NAMES - Merkezi Kırmızı Liste İsimleri
    // ==========================================================================
    match /admin_red_list_names/{docId} {
      allow read, write: if signedIn();
    }

    // ==========================================================================
    // ADMIN NOTIFICATIONS - Bildirim Tetikleyici (Cloud Function için)
    // ==========================================================================
    // Kullanıcılar bildirim isteği oluşturabilir.
    // Okuma/silme yalnızca Cloud Function'a aittir (Admin SDK kuralları atlar).
    match /admin_notifications/{notificationId} {
      allow create: if signedIn();
      allow read, write, delete: if false;
    }

    // ==========================================================================
    // ADMINS - Admin Kullanıcılar (eski/kullanılmıyor)
    // ==========================================================================
    // NOT: Bu koleksiyon admin_users ile KARIŞTIRILMAMALIDIR.
    // Yetki kaynağı admin_users'tır; burası eski bir kalıntıdır.
    match /admins/{userId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ==========================================================================
    // PERMISSION REQUESTS - İzin İstekleri
    // ==========================================================================
    match /permission_requests/{requestId} {
      allow read, write: if signedIn();
    }

    // ==========================================================================
    // DEFAULT DENY - EN SONDA OLMALI
    // ==========================================================================
    // Yukarıdaki kurallardan hiçbiri eşleşmezse erişim reddedilir.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
