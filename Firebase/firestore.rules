// ============================================================================
// CheckingCBGuest — Firestore Güvenlik Kuralları
// ============================================================================
//
// Son güncelleme: 2026-09-02 (v1.6.1 — GEÇİŞ SÜRÜMÜ: okuma kısıtı geçici kapalı)
//
// ---------------------------------------------------------------------------
// v1.6.1 NEDEN VAR — OKUMADAN DEĞİŞTİRMEYİN
// ---------------------------------------------------------------------------
// v1.6 yayınlandığında yönetici olmayan HİÇBİR hesap (iOS ve Android) etkinlik
// göremedi: ne geçmiş, ne bugün, ne gelecek. Sebep kuralın mantığı değil,
// YAYIN SIRASIYDI:
//
//   * Kural, istemcinin `eventDayKey >= bugün` ile daraltılmış sorgu kurmasını
//     şart koşar.
//   * Ancak Firestore'daki `events` dokümanlarında `eventDayKey` alanı HİÇ YOKTU
//     (geri doldurma betiği çalıştırılmamıştı).
//   * Bir aralık sorgusu, o alanı taşımayan belgeyi hiç döndürmez. Alan hiçbir
//     belgede olmayınca sonuç kümesi TAMAMEN boşaldı.
//   * Üstelik cihazlardaki uygulama sürümleri sorguyu henüz daraltmıyordu;
//     daraltılmamış sorgu ise belge elemek yerine `permission-denied` alır ve
//     istemci bunu boş liste olarak gösterir.
//
// Bu dosya arızayı DURDURUR: okuma kısıtı geçici olarak kaldırılmıştır. Kısıtı
// üreten yardımcı fonksiyonlar (minVisibleDayKey / eventVisible /
// parentEventVisible) BİLEREK dosyada bırakıldı; geri açmak üç satırlık iştir.
//
// ---------------------------------------------------------------------------
// KISITI GERİ AÇMA SIRASI — hepsi bitmeden yayınlamayın
// ---------------------------------------------------------------------------
//   1. Geri doldurma: `node Firebase/scripts/backfill-event-day-key.js --apply`
//      Betiği tekrar çalıştırıp `eksik : 0` gördüğünüzde bu adım biter.
//   2. iOS VE ANDROID'in daraltılmış sorgulu sürümleri KULLANICILARDA olsun.
//      Eski sürümde kalan tek bir cihaz yine bomboş liste görür.
//   3. Bu dosyada aşağıdaki [GERİ AÇ] işaretli üç yeri değiştirip yayınlayın.
//   4. Yönetici OLMAYAN bir hesapla doğrulayın: bugünün etkinliği görünüyor,
//      geçmiş etkinlik görünmüyor.
//
// Ayrıntılı gerekçe: Firebase/GECIS-RUNBOOK.md
//
// ---------------------------------------------------------------------------
// v1.4'TEN DEVREDEN DAVRANIŞ (değişmedi)
// ---------------------------------------------------------------------------
//   * isAdmin() koda gömülü liste yerine `admin_users` koleksiyonunu okur.
//     Yönetici eklemek için mağaza güncellemesi gerekmez.
//   * device_bindings: bir e-posta yalnızca tek cihaza bağlanır.
//   * admin_users: istemci ASLA yazamaz.
//
// DİKKAT: her yönetici e-postası için admin_users/<küçük-harfli-eposta>
// dokümanı { isAdmin: true } ile mevcut OLMALIDIR. Yoksa yönetici cihazlar
// authorized_devices'a yazamaz ve yönetici işlevleri kilitlenir.
//
// Deploy: firebase deploy --only firestore:rules
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================================
    // YARDIMCI FONKSİYONLAR
    // ==========================================================================

    function signedIn() {
      return request.auth != null;
    }

    // Oturum açmış kullanıcının normalize edilmiş e-postası.
    // NOT: rules'taki lower() locale'den BAĞIMSIZDIR. iOS istemcisi
    // AppAuth.normalizedEmailKey() içinde en_US_POSIX ile küçültür; Türkçe
    // locale'de "I" → "ı" olacağı için bu zorunludur, aksi halde doküman ID'si
    // buradaki lower() ile eşleşmez ve her yazma reddedilirdi.
    function normEmail() {
      return request.auth.token.get('email', '').lower();
    }

    // Yönetici listesi `admin_users` koleksiyonundadır.
    // Yönetici eklemek : admin_users/<eposta> dokümanı, alan isAdmin = true
    // Yönetici çıkarmak: dokümanı sil veya isAdmin = false yap
    function isAdmin() {
      return signedIn()
          && exists(/databases/$(database)/documents/admin_users/$(normEmail()))
          && get(/databases/$(database)/documents/admin_users/$(normEmail()))
               .data.get('isAdmin', false) == true;
    }

    // ---- Geçmiş etkinlik görünürlüğü (şu an KULLANILMIYOR — bkz. [GERİ AÇ]) ---
    //
    // Fonksiyonlar bilerek duruyor: kısıt geri açılırken tek yapılacak iş
    // aşağıdaki üç [GERİ AÇ] bloğundaki okuma satırlarını değiştirmektir.
    // Kullanılmayan fonksiyon Firestore tarafında hata değildir.

    // Bir zaman damgasından sıralanabilir gün anahtarı: 2026-08-31 -> 20260831.
    function dayKeyOf(t) {
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    // Yönetici olmayan cihazın görebileceği EN ESKİ gün.
    //
    // request.time UTC'dir; Türkiye sabit UTC+3 (yaz saati yok) olduğu için 3 saat
    // eklenerek yerel güne çevrilir.
    //
    // Neden 1 gün tolerans (-24s)? İstemci, sorgunun alt sınırını KENDİ saatinden
    // hesaplamak zorundadır (whereField eventDayKey >= bugün). Cihaz saati veya zaman
    // dilimi sunucudan geride kalırsa alt sınır bir gün eskiye kayar; tolerans olmadan
    // sorgu tek tek belge elemek yerine TAMAMEN reddedilir ve kullanıcı bomboş bir liste
    // görür. Bedeli bilinçlidir: kötü niyetli bir istemci sorgusunu elle bir gün geriye
    // çekerek yalnızca DÜNKÜ etkinlikleri görebilir, daha eskisini göremez.
    function minVisibleDayKey() {
      return dayKeyOf(request.time + duration.value(3, 'h') - duration.value(24, 'h'));
    }

    // Misafir kayıtları için üst etkinliğin görünürlüğü.
    //
    // isAdmin() BİLEREK önce çağrılır: üst etkinlik dokümanı (yarım kalmış bir silme
    // yüzünden) yoksa get() hata verir ve kural reddeder; yönetici bu durumda da
    // öksüz kayıtlara erişebilmelidir.
    function parentEventVisible(eventId) {
      return isAdmin()
          || get(/databases/$(database)/documents/events/$(eventId))
               .data.get('eventDayKey', 0) >= minVisibleDayKey();
    }

    // Gün anahtarı bir kez yazıldıktan sonra yalnızca yönetici değiştirebilir.
    // Alan hiç yoksa ilk yazıma izin verilir; böylece geri doldurmayı kaçırmış bir
    // kayıt istemci tarafından onarılabilir.
    function dayKeyUnchangedOrAdmin() {
      return isAdmin()
          || !('eventDayKey' in resource.data)
          || request.resource.data.get('eventDayKey', 0) == resource.data.eventDayKey;
    }

    // Bu yazma, kaydı "silinmiş" duruma geçiriyor mu?
    // Zaten silinmiş bir kaydın tekrar yazılması silme sayılmaz.
    function marksDeleted() {
      return request.resource.data.get('deleted', false) == true
          && resource.data.get('deleted', false) != true;
    }

    // ==========================================================================
    // ADMIN USERS - Yönetici E-posta Listesi
    // ==========================================================================
    // Doküman ID'si = küçük harfli e-posta, alan: isAdmin (boolean).
    // İstemci ASLA yazamaz — yalnızca Console / Admin SDK.
    //
    // Okuma yalnızca kişinin KENDİ kaydıyla sınırlıdır (kimse başkasının yönetici
    // olup olmadığını göremez). isAdmin() içindeki get()/exists() çağrıları
    // kuralları atladığı için bu kısıt isAdmin()'i etkilemez.
    match /admin_users/{emailId} {
      allow read: if signedIn() && emailId == normEmail();
      allow write: if false;
    }

    // ==========================================================================
    // DEVICE BINDINGS - E-posta ↔ Cihaz Bağı
    // ==========================================================================
    // Bir e-posta = bir cihaz. Doküman ID'si küçük harfli e-postadır, böylece
    // sahip Console'da dokümanı e-posta ile bulup silerek bağı sıfırlayabilir.
    match /device_bindings/{emailId} {

      allow read: if signedIn() && emailId == normEmail();

      // İlk bağlama.
      allow create: if signedIn()
        && emailId == normEmail()
        && request.resource.data.email == emailId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() > 0;

      // deviceId DEĞİŞTİRİLEMEZ — özelliğin bel kemiği budur.
      // Pratikte yalnızca lastSeenAt güncellenebilir.
      allow update: if signedIn()
        && emailId == normEmail()
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.boundAt == resource.data.boundAt;

      // Bağı YALNIZCA sahip (Console) sıfırlayabilir.
      allow delete: if false;
    }

    // ==========================================================================
    // AUTHORIZED DEVICES - Cihaz Yetkilendirme
    // ==========================================================================
    // Herkes cihaz kaydını okuyabilir ve kendi kaydını yazabilir; ancak
    // isAdmin=true yalnızca admin_users'da kayıtlı bir hesapla açılabilir.
    match /authorized_devices/{deviceId} {
      allow read: if signedIn();
      allow write: if signedIn()
                   && (request.resource.data.get('isAdmin', false) != true || isAdmin());
    }

    // ==========================================================================
    // EVENTS - Etkinlik Yönetimi                                      [GERİ AÇ 1]
    // ==========================================================================
    // v1.6.1: okuma kısıtı GEÇİCİ olarak kaldırıldı; create'teki `eventDayKey is
    // int` şartı da kaldırıldı — o şart, alanı yazmayan eski uygulama sürümlerinin
    // etkinlik OLUŞTURMASINI da engelliyordu.
    //
    // [GERİ AÇ] Geri doldurma bitip her iki istemci yayınlandığında aşağıdaki
    // `allow read` ve `allow create` satırlarını silip yerine şunları koyun:
    //
    //   allow get:  if signedIn()
    //               && (isAdmin()
    //                   || resource.data.get('eventDayKey', 99999999) >= minVisibleDayKey());
    //   allow list: if signedIn()
    //               && (isAdmin() || resource.data.eventDayKey >= minVisibleDayKey());
    //   allow create: if signedIn() && request.resource.data.eventDayKey is int;
    //   allow update: if signedIn()
    //                 && (!marksDeleted() || isAdmin())
    //                 && dayKeyUnchangedOrAdmin();
    //
    // `get` ile `list` AYRI yazılmalıdır ve bu zorunludur: liste sorgusunda koşul,
    // sorgunun kendi filtresinden KANITLANABİLİR olmak zorundadır. Varsayılanlı
    // biçim (`resource.data.get('eventDayKey', 0)`) kanıtlanamaz; Firestore bunu
    // değerlendirme hatası sayar ve DARALTILMIŞ sorguyu bile reddeder. Tek parça
    // `allow read` yazılırsa arıza aynen geri gelir. Tekil belge okumasında
    // (`get`) böyle bir kısıt yoktur; orada eksik alanı görünür sayan hoşgörülü
    // biçim, geri doldurma tamamlanmadan detay ekranlarının kırılmasını önler.
    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (!marksDeleted() || isAdmin());
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // GUESTS - Genel Misafir Listesi (Public)                         [GERİ AÇ 2]
    // ==========================================================================
    // Giriş/çıkış, saat düzeltme, ünvan güncelleme vb. herkese açık.
    // SİLME yalnızca yöneticiye.
    //
    // [GERİ AÇ] `allow read` yerine:
    //   allow read: if signedIn() && parentEventVisible(eventId);
    //
    // YAZMA bilinçli olarak kısıtlanmaz: geçmiş etkinlikte değişikliği zaten
    // istemci engelliyor; buraya koşul eklemek, gün anahtarı eksik kalmış tek bir
    // kayıtta tüm giriş/çıkış işlemlerini kilitleme riskini getirirdi.
    match /events/{eventId}/guests/{guestId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (!marksDeleted() || isAdmin());
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // GUESTS_SECURE - Kırmızı Liste Misafirleri                       [GERİ AÇ 3]
    // ==========================================================================
    // Onay bekleyen kayıtlar. /guests ile AYNI silme modeli uygulanır:
    // oluşturma ve normal güncelleme herkese açık (misafir ekleyen görevlinin
    // kırmızı listeye takılan kaydı buraya düşer), silme yalnızca yöneticiye.
    //
    // [GERİ AÇ] `allow read` yerine:
    //   allow read: if signedIn() && parentEventVisible(eventId);
    match /events/{eventId}/guests_secure/{guestId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (!marksDeleted() || isAdmin());
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // RED LIST - Kırmızı Liste Koleksiyonu (eski)
    // ==========================================================================
    match /red_list/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ==========================================================================
    // ADMIN RED LIST NAMES - Merkezi Kırmızı Liste İsimleri
    // ==========================================================================
    match /admin_red_list_names/{docId} {
      allow read, write: if signedIn();
    }

    // ==========================================================================
    // ADMIN NOTIFICATIONS - Bildirim Tetikleyici (Cloud Function için)
    // ==========================================================================
    // Kullanıcılar bildirim isteği oluşturabilir.
    // Okuma/silme yalnızca Cloud Function'a aittir (Admin SDK kuralları atlar).
    match /admin_notifications/{notificationId} {
      allow create: if signedIn();
      allow read, write, delete: if false;
    }

    // ==========================================================================
    // ADMINS - Admin Kullanıcılar (eski/kullanılmıyor)
    // ==========================================================================
    // NOT: Bu koleksiyon admin_users ile KARIŞTIRILMAMALIDIR.
    // Yetki kaynağı admin_users'tır; burası eski bir kalıntıdır.
    match /admins/{userId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ==========================================================================
    // PERMISSION REQUESTS - İzin İstekleri
    // ==========================================================================
    match /permission_requests/{requestId} {
      allow read, write: if signedIn();
    }

    // ==========================================================================
    // DEFAULT DENY - EN SONDA OLMALI
    // ==========================================================================
    // Yukarıdaki kurallardan hiçbiri eşleşmezse erişim reddedilir.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
